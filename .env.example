PORT=3001
HOST=0.0.0.0
# Allowed CORS and Socket.IO origin. The development client uses 127.0.0.1:5173;
# in Docker or production set the public URL, e.g. https://melody.example.com (no trailing slash).
# Empty value accepts any origin.
CLIENT_ORIGIN=http://127.0.0.1:5173
ROOM_DB_PATH=./data/rooms.sqlite
ROOM_TTL_HOURS=72
YANDEX_MUSIC_TOKEN=
YANDEX_MUSIC_USE_DEMO=false
YANDEX_MUSIC_ALLOW_FULL_TRACK_FALLBACK=false
AUDIO_DELIVERY_MODE=direct
AUDIO_CACHE_MAX_BYTES=8000000
AUDIO_CACHE_LOOKAHEAD=2
ROUND_AUDIO_WARMUP_MS=
